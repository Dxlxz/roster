  "engines": {
    "node": "^26.5.1",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2",
    "roster": ">=2.19.0"
  },
  "keywords": [
    "roster-app"
  ],
  "packageManager": "yarn@4.18.1",
  "scripts": {
