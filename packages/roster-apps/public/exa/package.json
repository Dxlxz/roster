    "oxlint": "^0.16.0",
    "roster-client-sdk": "2.37.0",
    "roster-sdk": "2.37.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.1.12"
  }
}
